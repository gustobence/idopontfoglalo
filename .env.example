# Minta a környezeti változókhoz. A valódi értékek a ".env.local" fájlba kerülnek.
# A .env.local NEM kerül fel a GitHubra (a .gitignore kizárja).

# ── Első beállítás (npm run db:setup) ──────────────────────────────────────
# Írd be a Neon "Connect" ablakából kimásolt TULAJDONOSI címet (neondb_owner).
# A telepítő ebből létrehozza a táblát és a korlátozott felhasználót,
# majd ezt a sort TÖRLI, és helyette beírja a DATABASE_URL-t.
# DATABASE_URL_ADMIN=postgresql://neondb_owner:...@ep-....neon.tech/neondb?sslmode=require

# ── Az alkalmazás kapcsolata ───────────────────────────────────────────────
# A korlátozott foglalo_app felhasználó címe – ezt a telepítő írja be.
# Ha nincs megadva, az alkalmazás tesztüzemben fut (tesztfoglalásokkal, mentés nélkül).
DATABASE_URL=

# ── Admin belépés (npm run admin:jelszo állítja be) ───────────────────────
# A jelszó LENYOMATA (nem maga a jelszó) és a bejelentkezési sütik aláíró kulcsa.
ADMIN_JELSZO_HASH=
MUNKAMENET_TITOK=
